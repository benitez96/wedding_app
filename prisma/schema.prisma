
generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

// Usuario del sistema
// Better Auth maneja los campos core de autenticación
// Cada usuario puede crear sus propios eventos (bodas/fiestas)
// y manejar el backoffice de SUS eventos

model User {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Campos de Better Auth (auto-generados por CLI)
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  
  // Relaciones
  ownedEvents          Event[]                @relation("EventOwner")
  eventMemberships     EventMember[]
  sessions             Session[]
  accounts             Account[]
  subscription         Subscription?          @relation("UserSubscription")
  subscriptionHistory  SubscriptionHistory[]
  checkIns             CheckIn[]              @relation("CheckInsByUser")
  deletedCheckIns      CheckIn[]              @relation("CheckInsDeletedByUser")

  @@map("users")
}

// ============================================
// SUSCRIPCIONES
// ============================================

// Enums para suscripciones
enum SubscriptionTier {
  FREE
  BASIC
  COMPANY
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  incomplete
  trialing
  paused
}

enum SubscriptionEventType {
  created
  upgraded
  downgraded
  renewed
  canceled
  expired
  payment_failed
  reactivated
}

enum SecurityLogType {
  login_attempt
  login_success
  login_failed
  rate_limit_triggered
  honeypot_triggered
  user_setup_failed
}

// Suscripción ACTUAL del usuario (1 fila por usuario)
model Subscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Usuario (relación 1:1)
  userId    String   @unique
  user      User     @relation("UserSubscription", fields: [userId], references: [id], onDelete: Cascade)
  
  // Plan actual
  tier      SubscriptionTier   @default(FREE)
  status    SubscriptionStatus @default(active)
  
  // Payment Provider (agnóstico)
  paymentProvider           String?  // stripe | mercadopago | paypal | etc
  paymentProviderCustomerId String?  @unique // ID del customer en el proveedor
  externalSubscriptionId    String?  @unique // ID de la suscripción en el proveedor externo
  externalPriceId           String?  // ID del precio/plan en el proveedor
  externalProductId         String?  // ID del producto en el proveedor
  
  // Fechas del ciclo de facturación
  currentPeriodStart DateTime? // Inicio del período actual
  currentPeriodEnd   DateTime? // Fin del período actual (cuándo se cobra el próximo pago)
  
  // Cancelación
  cancelAtPeriodEnd Boolean  @default(false) // Si está cancelado pero sigue activo hasta el fin del período
  canceledAt        DateTime? // Cuándo se canceló
  
  // Trial (si aplica)
  trialStart DateTime? // Inicio del trial
  trialEnd   DateTime? // Fin del trial
  
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// Historial completo de suscripciones (auditoría)
model SubscriptionHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  
  // Usuario
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Qué cambió
  eventType SubscriptionEventType
  
  // Estado anterior y nuevo
  fromTier  SubscriptionTier?   // Tier anterior (null si es nueva suscripción)
  toTier    SubscriptionTier    // Tier nuevo
  
  fromStatus SubscriptionStatus? // Status anterior
  toStatus   SubscriptionStatus  // Status nuevo
  
  // Metadata del cambio
  reason       String?  // Motivo del cambio (ej: "User requested cancellation", "Payment failed", "Admin upgrade")
  changedBy    String?  // Quién hizo el cambio (userId del admin, "webhook:stripe", "webhook:mercadopago", "system", etc.)
  
  // Datos de pago (agnóstico del proveedor)
  paymentProvider      String? // stripe | mercadopago | paypal
  externalEventId      String? // ID del evento/webhook del proveedor
  externalInvoiceId    String? // ID de la factura en el proveedor
  externalTransactionId String? // ID de la transacción
  amount               Int?    // Monto pagado (en centavos)
  currency             String? // Moneda (USD, ARS, EUR, etc.)
  
  // Fechas relevantes
  effectiveDate    DateTime @default(now()) // Cuándo el cambio tomó efecto
  periodStart      DateTime? // Inicio del período de esta suscripción
  periodEnd        DateTime? // Fin del período de esta suscripción
  
  // Metadata adicional (JSON para flexibilidad)
  metadata Json? // Cualquier dato extra (ej: descuentos, cupones, etc.)
  
  @@index([userId, createdAt])
  @@index([eventType])
  @@index([effectiveDate])
  @@map("subscription_history")
}

// ============================================
// EVENTOS (Multi-tenant)
// ============================================

// Evento = Invitación/Servidor (cada evento es independiente)

model Event {
  id          String                 @id @default(cuid())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  // Información básica
  name        String
  slug        String                 @unique
  description String?
  // Configuración visual (cada evento tiene su propio theme)
  activeTheme String                 @default("classic")
  customTheme Json?                  // CustomThemeColors (solo usado cuando activeTheme = "custom")
  // Owner (quien creó el evento)
  ownerId     String
  owner       User                   @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Relaciones
  invitations    Invitation[]
  sections       SectionConfiguration[]
  members        EventMember[]
  inviteLinks    EventInviteLink[]
  configurations Configuration[]

  @@index([ownerId])
  @@index([slug])
  @@map("events")
}

// Miembro de un evento (colaborador)

model EventMember {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Relaciones
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Permisos (bitmask - BigInt para soportar 64 permisos)
  permissions BigInt    @default(0)
  // Metadata de invitación
  invitedBy   String
  invitedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([userId, revokedAt]) // PERFORMANCE: Active memberships for user
  @@index([eventId, revokedAt]) // PERFORMANCE: Active collaborators per event
  @@map("event_members")
}

// Links de invitación para colaboradores

model EventInviteLink {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Token único para el link
  token       String    @unique
  // Permisos que se asignarán al aceptar
  permissions BigInt    @default(0)
  // Metadata
  createdBy   String
  expiresAt   DateTime?
  maxUses     Int?      @default(1)
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)

  @@index([token])
  @@index([eventId])
  @@index([eventId, isActive]) // PERFORMANCE: Active invite links per event
  @@index([expiresAt]) // PERFORMANCE: Cleanup expired links
  @@map("event_invite_links")
}

// ============================================
// INVITACIONES
// ============================================

// Invitaciones principales

model Invitation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Relación con evento
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Información de la invitación
  guestName     String
  guestNickname String?
  guestPhone    String?
  maxGuests     Int      @default(1)

  // Guest response
  hasResponded         Boolean   @default(false)
  isAttending          Boolean?
  guestCount           Int?
  respondedAt          DateTime?
  // Extended RSVP fields (optional, only collected when enabled in section settings)
  menuPreference       String?   // Selected menu option (e.g. "Carne", "Vegetariano")
  dietaryRestrictions  String?   // Free text, null = no restrictions
  messageForCouple     String?   // Free text message from guest to couple
  
  // Check-in tracking
  checkInCount  Int       @default(0)  // Cache: total de personas que ya ingresaron
  lastCheckInAt DateTime?              // Última vez que se escaneó esta invitación
  
  // Relaciones
  tokens       InvitationToken[]
  checkIns     CheckIn[]

  @@index([eventId])
  @@index([guestName])
  @@index([guestPhone])
  @@index([eventId, updatedAt]) // Composite index for efficient delta queries
  @@index([eventId, hasResponded]) // PERFORMANCE: Filter by event + response status
  @@index([eventId, isAttending]) // PERFORMANCE: Filter confirmed/declined guests
  @@index([createdAt]) // PERFORMANCE: Sorting by creation date
  @@map("invitations")
}

// Tokens únicos para cada invitación

model InvitationToken {
  // Crypto-secure random ID (21 chars, base64url, ~126 bits of entropy)
  // This IS the token used in invitation URLs: /r/{id}
  // Generated via crypto.randomBytes in createInvitationToken action
  id            String    @id
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Estado del token (se puede revocar sin eliminar)
  isActive      Boolean   @default(true)
  isUsed        Boolean   @default(false)
  // Expiración (default 1 año desde creación, revocable desde backoffice)
  expiresAt     DateTime
  // Información de uso del token
  firstAccessAt DateTime?
  lastAccessAt  DateTime?
  deviceId      String?
  userAgent     String?
  accessCount   Int       @default(0)

  // Relaciones
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([isActive])
  @@index([invitationId, isActive, isUsed]) // PERFORMANCE: Compound index for common filters
  @@index([expiresAt]) // PERFORMANCE: Find expired tokens for cleanup
  @@map("invitation_tokens")
}

// ============================================
// CHECK-IN (QR Scanner)
// ============================================

// Registro de cada check-in (entrada al evento)
// Soporta flujo offline-first con sincronización posterior
model CheckIn {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  
  // Relación con invitación
  invitationId  String
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  
  // Quién hizo el check-in (staff member)
  checkedInBy   String
  checkedByUser User       @relation("CheckInsByUser", fields: [checkedInBy], references: [id], onDelete: Cascade)
  
  // Cuántas personas ingresaron en ESTE check-in
  guestsCount   Int       @default(1)
  
  // Metadata para offline-first
  clientId      String    @default(cuid()) @unique // UUID generado en cliente (deduplicación en sync)
  deviceId      String?                            // Identificador del dispositivo que hizo el check-in
  syncedAt      DateTime?                          // NULL = creado offline y pendiente de sync
  
  // Soft delete (trazabilidad)
  deletedAt     DateTime?
  deletedBy     String?
  deletedByUser User?      @relation("CheckInsDeletedByUser", fields: [deletedBy], references: [id], onDelete: SetNull)
  
  // Gestión de excesos de capacidad (offline)
  // Si al sincronizar se detecta que se excedió maxGuests, se marca pero NO se rechaza
  exceededCapacity Boolean  @default(false)     // TRUE si este check-in excedió la capacidad
  capacityNote     String?                       // Ej: "Ingresaron 5/4 personas (exceso: 1)"
  
  @@index([invitationId])
  @@index([syncedAt])
  @@index([clientId])
  @@index([deletedAt])
  @@index([exceededCapacity])
  @@index([invitationId, deletedAt]) // PERFORMANCE: Active check-ins per invitation
  @@index([checkedInBy, createdAt]) // PERFORMANCE: Check-ins by staff member
  @@map("check_ins")
}

// ============================================
// RATE LIMITING & SECURITY
// ============================================

// Better Auth rate limiting (persistent, survives restarts)
// Used by Better Auth's built-in rate limiter with storage: "database"

model RateLimit {
  id          String   @id @default(cuid())
  key         String
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// App-level rate limiting - Intentos de acceso

model RateLimitAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // Información del intento
  ip        String
  actionType String // 'invitation-token', 'admin-login', 'invitation-actions'
  success   Boolean  @default(false)

  @@index([ip, actionType, createdAt])
  @@map("rate_limit_attempts")
}

// Rate limiting - Bloqueos de IP

model RateLimitBlock {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  // Información del bloqueo
  ip           String
  actionType   String // 'invitation-token', 'admin-login', 'invitation-actions'
  blockedUntil DateTime
  reason       String?

  @@index([ip, actionType, blockedUntil])
  @@map("rate_limit_blocks")
}

// Logs de seguridad para auditoría

model SecurityLog {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  // Tipo de evento
  type      SecurityLogType
  // Información del cliente
  ip        String
  userAgent String
  // Detalles adicionales (JSON)
  details   Json?

  @@index([ip, type, createdAt])
  @@index([type, createdAt]) // PERFORMANCE: Audit logs by type
  @@index([createdAt]) // PERFORMANCE: Recent security events
  @@map("security_logs")
}

// ============================================
// CONFIGURACIÓN
// ============================================

model Configuration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key         String
  value       String
  description String?

  // Scoped por evento
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key]) // Cada key es única POR evento
  @@index([eventId])
  @@map("configurations")
}

// Configuración de secciones de la invitación (ahora por evento)

model SectionConfiguration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Relación con evento
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Identificador de sección (hero, date, ceremony, divider, etc.)
  // NOTA: Puede repetirse (ej: múltiples dividers)
  // La unicidad para secciones NO-divider se valida en código
  key       String
  // Control de visualización
  isEnabled Boolean  @default(true)
  order     Int
  // Configuración específica (JSON validado con Zod)
  settings  Json?

  @@index([eventId, order])
  @@index([eventId, key])
  @@map("section_configurations")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}
