# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=wedding_app
POSTGRES_PORT=5432
POSTGRES_HOST=db
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ============================================
# BETTER AUTH
# ============================================
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# ============================================
# GOOGLE OAUTH (OPCIONAL)
# ============================================
# Obtener de: https://console.cloud.google.com/
# Ver GOOGLE_OAUTH_SETUP.md para instrucciones completas
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_WEDDING_DATE=20260214193000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TZ=America/Argentina/Buenos_Aires
NODE_ENV=development
PORT=3000

# ============================================
# SECURITY
# ============================================
CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true

# ============================================
# GRAFANA (OPCIONAL)
# ============================================
GRAFANA_PASSWORD=admin123

# ============================================
# DOMAIN
# ============================================
DOMAIN=localhost

# ============================================
# BASIC AUTH (OPCIONAL - para subdominios protegidos)
# ============================================
# Generar con: caddy hash-password --plaintext TU_PASS
BASIC_AUTH_HASH=
